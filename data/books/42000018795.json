sa con la ayuda de su madre. Años más tarde, Ava ahora es una poderosa CEO y regresa para rescatar a su madre, donde cae en la trampa de su familia. Pero ya no es la víctima; ahora, volvió para destruirlos y cumplir con su tan esperada venganza.", "chapterCount": 75, "labels": ["Comeback Story", "Strong Female Lead"], "tags": ["Comeback Story", "Strong Female Lead"], "typeTwoIds": [356, 341, 335], "typeTwoNames": ["Renacimiento y Venganza", "Regreso con Fuerza", "Venganza"], "typeTwoList": [{"id": 356, "name": "Renacimiento y Venganza", "replaceName": "renacimiento-y-venganza"}, {"id": 341, "name": "Regreso con Fuerza", "replaceName": "regreso-con-fuerza"}, {"id": 335, "name": "Venganza", "replaceName": "venganza"}], "language": "SPANISH", "typeTwoName": "Renacimiento-y-Venganza", "simpleLanguage": "es", "bookNameEn": "De-Pueblerina-Marginada-a-Rosa-Florecida", "bookNameLower": "de-pueblerina-marginada-a-rosa-florecida", "shelfTime": "2026-11-19 10:00:05", "firstShelfTime": "2026-11-19 10:00:05", "performerIdList": []}], "chapterList": [{"id": "701166432", "name": "第一集", "index": 0, "indexStr": "001", "unlock": true, "mp4": "https://hwvideoseo.dramaboxdb.com/23/5x9/59x7/597x8/59781000024/701166432_1/701166432.720p.narrowv3.mp4?Expires=1795219200&Signature=TMlG6MDr1DmxEpnuw6yhrKdrVhjSeReBdP-Sq74qM~L2li-RVa6CndO8UA1jN2acKpf~BClfnsLE0ohUziw325Apuii9AUIVg2sLgx6f5uHmVNq7ymUfOU20VDvZUWW2KK~8ped2ndBB0x7SUOeNW9dKx3gIZztd8tDr0gimNCyAcatdfAgFQ94CWCNeC1qN3UJrkrUP1NPhTT5P1H-u6t3LgO~58r2s-UoHLAPplNjb6VTy1sGnuSCUvsV4HP77liUgvUKwysLjCpXjPoZoHjcD7ow0LPuJp11PLEn1V7QLi-oPEoktA5Xf9VM500foMzqv0Pm6gdcWbUKdiSqRfQ__&Key-Pair-Id=K3HA2TLE2QH99V", "m3u8Flag": false, "cover": "https://thwztvideo.dramaboxdb.com/23/5x9/59x7/597x8/59781000024/701166432_1/701166432.mp4.jpg@w=100&h=135", "utime": "2026-06-26", "chapterPrice": 0, "duration": 257950, "new": false}, {"id": "701166433", "name": "第二集", "index": 1, "indexStr": "002", "unlock": true, "mp4": "https://hwvideoseo.dramaboxdb.com/33/5x9/59x7/